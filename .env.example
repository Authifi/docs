COMPOSE_PROJECT_NAME=authifi-docs-local
DOCS_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
POST_LOGOUT_PATH=/privacy-policy/
OIDC_ISSUER=https://your-authifi-tenant.example.com
OIDC_CLIENT_ID=your-authifi-client-id
OIDC_CLIENT_SECRET=replace-with-real-client-secret
SESSION_SECRET=replace-with-a-long-random-local-secret
MOCK_OIDC_PORT=9400
# Only the host needs to resolve this; the docs container reaches the provider
# through a Compose network alias of the same name. Resolved through nip.io, so
# the default needs public DNS. Offline machines and resolvers with DNS
# rebinding protection will not resolve it; add
# `127.0.0.1 oidc-mock.local.test` to /etc/hosts and use that name instead.
MOCK_OIDC_HOST=oidc-mock.127.0.0.1.nip.io
MOCK_OIDC_SUBJECT=alice@example.com
